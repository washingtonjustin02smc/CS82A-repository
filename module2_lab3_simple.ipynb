   "source": [
    "temperatures = [10, 16, 23, 28, 14, 22, 30]\n",
    "\n",
    "for temperature in temperatures:\n",
    "    if temperature < 15:\n",
    "        label = \"Cold\"\n",
    "    elif temperature <= 25:\n",
    "        label = \"Warm\"\n",
    "    else:\n",
    "        label = \"Hot\"\n",
    "\n",
    "    print(f\"{temperature}°C - {label}\")"
   ]
  }
