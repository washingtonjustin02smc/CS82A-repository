      "source": [
        "# Calculate minimum, mean, and maximum weight for each feed type.\n",
        "summary = (\n",
        "    df.groupby('feed')['weight']\n",
        "      .agg(['min', 'mean', 'max'])\n",
        "      .reset_index()\n",
        "      .sort_values('mean', ascending=False)\n",
        ")\n",
        "summary['mean'] = summary['mean'].round(2)\n",
